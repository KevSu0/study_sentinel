{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "npm run lint:sw && eslint --ext .ts,.tsx,.js,.jsx --fix . && eslint --ext .ts,.tsx,.js,.jsx --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:stats:unit": "jest src/__tests__/stats/unit --testPathPattern=\\.test\\.ts$ --verbose",
    "test:stats:integration": "jest src/__tests__/stats/integration --testPathPattern=\\.test\\.ts$ --verbose",
    "test:stats:performance": "jest src/__tests__/stats/performance --testPathPattern=\\.test\\.ts$ --verbose",
    "test:stats:a11y": "jest src/__tests__/stats/a11y --testPathPattern=\\.test\\.ts$ --verbose",
    "test:stats:e2e": "playwright test src/__tests__/stats/e2e/",
    "test:stats:all": "npm run test:stats:unit && npm run test:stats:integration && npm run test:stats:performance && npm run test:stats:a11y",
    "analyze": "ANALYZE=true next build",
    "lint:sw": "node ./scripts/check-sw-artifacts.js",
    "prepare": "husky install",
    "verify:sw-scope": "node ./scripts/verify-sw-scope.js",
    "verify:assets": "node ./scripts/check-asset-integrity.js",
    "lint:staged": "lint-staged",
    "scan:remote-apis": "node ./scripts/check-remote-api-literals.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@genkit-ai/ai": "^1.13.0",
    "@genkit-ai/googleai": "^1.13.0",
    "@genkit-ai/next": "^1.13.0",
    "@hookform/resolvers": "^4.1.3",
    "@opentelemetry/exporter-jaeger": "^2.0.1",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.0.8",
